# Modelo de ambiente do curio — copie para `.env` e preencha.
# `.env` está no .gitignore: NUNCA commite chaves reais.

# --- NVIDIA API (geração de roteiros) ---
# Uma chave basta. Gere em https://build.nvidia.com
NVIDIA_API_KEY=

# Preparação FUTURA para múltiplas chaves (formato key1,key2,key3).
# ATENÇÃO: rotação/sorteio/fallback NÃO implementados — usa-se a 1ª chave.
#NVIDIA_API_KEYS=

# Modelo (ID exato da API). Principal atual: Nemotron 3 Ultra.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Base da API (só mude para simular falhas em teste local).
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Timeout em segundos por chamada (roteiro; cenas usam o mesmo).
NVIDIA_TIMEOUT=120

# --- Mídia (opcional) ---
# Pexels entra como fonte extra se houver chave (grátis com cadastro em
# https://www.pexels.com/api/). Sem chave, Wikimedia + Openverse cobrem.
#PEXELS_API_KEY=

# --- Pipeline (sobrescrevem config.toml) ---
#CURIO_OUT_DIR=output
#CURIO_TTS=edge-tts          # edge-tts (neural) | espeak-ng (local offline)
#CURIO_VOICE=pt-BR-AntonioNeural  # masculina PT-BR
#CURIO_BACKEND=auto
#CURIO_DURATION=45
