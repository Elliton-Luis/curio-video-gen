# Modelo de ambiente do curio — copie para `.env` e preencha.
# `.env` está no .gitignore: NUNCA commite chaves reais.

# --- LLM: rodízio NVIDIA → OpenRouter → Gemini → Groq ---
# Defina ao menos uma chave (a 1ª com chave tenta; sem nenhuma, roteiros
# locais). Gere em: NVIDIA https://build.nvidia.com · OpenRouter
# https://openrouter.ai/keys · Gemini https://aistudio.google.com/apikey
# · Groq https://console.groq.com/keys
NVIDIA_API_KEY=
#NVIDIA_API_KEYS=        # futuro: key1,key2 (hoje usa a 1ª)
#OPENROUTER_API_KEY=
#GEMINI_API_KEY=          # ou GOOGLE_API_KEY
#GROQ_API_KEY=

# --- Modelos/base (só mude p/ trocar de modelo ou simular falha local) ---
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#GEMINI_MODEL=gemini-2.5-flash
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#GROQ_MODEL=openai/gpt-oss-120b
#GROQ_BASE_URL=https://api.groq.com/openai/v1
# Timeout por chamada (s) e tentativas totais no rodízio (1-12).
#NVIDIA_TIMEOUT=120
# Teto do mesmo timeout: 15 é o padrão (comportamento antigo). Suba se o
# modelo da NIM for lento e você preferir esperar a cair no fallback.
#NVIDIA_TIMEOUT_MAX=90
#CURIO_LLM_ATTEMPTS=6

# --- Mídia (opcional: sem chave, Wikimedia + Openverse cobrem) ---
#PIXABAY_API_KEY=         # grátis com cadastro em https://pixabay.com/api/docs/
#PEXELS_API_KEY=          # grátis com cadastro em https://www.pexels.com/api/
#UNSPLASH_ACCESS_KEY=     # grátis com cadastro em https://unsplash.com/developers (cota demo)
# NASA Image Library não exige chave.

# --- Pipeline (sobrescrevem config.toml) ---
#CURIO_OUT_DIR=output
#CURIO_TTS=edge-tts          # edge-tts (neural) | espeak-ng (local offline)
#CURIO_VOICE=pt-BR-AntonioNeural
#CURIO_BACKEND=auto
#CURIO_DURATION=auto          # auto | 30 | 45 | 60 | 90 | 120 | 180 | Nºs
#CURIO_FILE_MANAGER=dolphin
#CURIO_AUDIO_RECORDER=audacity
#CURIO_AUTO_OPEN=1

# --- Pontuação semântica (opcional) ------------------------------------
# A camada base (lexical) é a padrão e não precisa de nada além do
# projeto. CLIP é desligado por padrão e o curio NÃO baixa torch,
# open_clip nem pesos de modelo automaticamente: instale à mão se quiser.
#   pip install torch            # huge; escolha a build da sua CPU
#   pip install open_clip_torch
# Só então:
# CURIO_CLIP_ENABLED=1
# CURIO_CLIP_DEVICE=auto        # auto | xpu | cuda | mps | cpu
# Com "auto" o projeto procura aceleradores que existam no torch
# instalado (xpu = Intel, cuda, mps) e só cai para cpu se nenhum houver.
# `video-gen doctor` mostra o estado da camada e o device em uso.

# --- Seleção de mídia (ajustes finos) ----------------------------------
# Nota mínima de relevância (0-100). Abaixo dela a cena troca de
# estratégia visual em vez de aceitar a imagem "menos ruim".
# 0 desliga o corte. Padrão: 34.
# CURIO_MEDIA_SCORE_MIN=34
# Lado mínimo da imagem em px, já que o render recorta para 1080x1920.
# CURIO_MEDIA_MIN_DIMENSION=1080

# --- Contato para a Wikimedia ---
# A Wikimedia (API da Wikipedia e Commons) exige um contato no User-Agent
# e responde HTTP 429 a toda requisição sem ele. Não tem chave, então é
# a única coisa nesta lista que você precisa preencher mesmo sem LLM:
# sem isso a pesquisa web cai e as imagens do Commons somem em silêncio.
CURIO_CONTACT=

# --- Gênero editorial (opcional) ---
# history | etymology | mythology | mystery | science | people
# Vazio = nenhum, e o vídeo sai exatamente como antes do recurso.
#CURIO_GENRE=people
