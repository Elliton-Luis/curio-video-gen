# Modelo de ambiente do curio — copie para `.env` e preencha.
# `.env` está no .gitignore: NUNCA commite chaves reais.

# --- LLM: rodízio NVIDIA → OpenRouter → Gemini → Groq ---
# Defina ao menos uma chave (a 1ª com chave tenta; sem nenhuma, roteiros
# locais). Gere em: NVIDIA https://build.nvidia.com · OpenRouter
# https://openrouter.ai/keys · Gemini https://aistudio.google.com/apikey
# · Groq https://console.groq.com/keys
NVIDIA_API_KEY=
#NVIDIA_API_KEYS=        # futuro: key1,key2 (hoje usa a 1ª)
#OPENROUTER_API_KEY=
#GEMINI_API_KEY=          # ou GOOGLE_API_KEY
#GROQ_API_KEY=

# --- Modelos/base (só mude p/ trocar de modelo ou simular falha local) ---
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
#NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#GEMINI_MODEL=gemini-2.5-flash
#GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#GROQ_MODEL=openai/gpt-oss-120b
#GROQ_BASE_URL=https://api.groq.com/openai/v1
# Timeout por chamada (s) e tentativas totais no rodízio (1-12).
#NVIDIA_TIMEOUT=120
#CURIO_LLM_ATTEMPTS=6

# --- Mídia (opcional: sem chave, Wikimedia + Openverse cobrem) ---
#PIXABAY_API_KEY=         # grátis com cadastro em https://pixabay.com/api/docs/
#PEXELS_API_KEY=          # grátis com cadastro em https://www.pexels.com/api/

# --- Pipeline (sobrescrevem config.toml) ---
#CURIO_OUT_DIR=output
#CURIO_TTS=edge-tts          # edge-tts (neural) | espeak-ng (local offline)
#CURIO_VOICE=pt-BR-AntonioNeural
#CURIO_BACKEND=auto
#CURIO_DURATION=auto          # auto | 30 | 45 | 60 | 90 | 120 | 180 | Nºs
#CURIO_FILE_MANAGER=dolphin
#CURIO_AUDIO_RECORDER=audacity
#CURIO_AUTO_OPEN=1
